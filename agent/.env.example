# --- Robinhood Chain ---
RPC_URL=
BREATH_TOKEN=
# Pons bonding curve + post-graduation pool, comma separated
POOL_ADDRESSES=
# Treasury wallet/contract (gets 30% of creator fee, does buybacks)
TREASURY_ADDRESS=
TOKEN_DECIMALS=18
START_BLOCK=0

# --- Heartbeat rules ---
MIN_TRADE_TOKENS=10000
WALLET_COOLDOWN_SEC=60

# --- Status thresholds (beats per hour) ---
HEALTHY_MIN=60
ANXIOUS_MIN=20
COMA_AFTER_SEC=21600
DEATH_AFTER_SEC=86400
REBIRTH_AFTER_SEC=86400

# --- AI (optional; without it the agent uses built-in templates) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# --- X (Twitter) API, OAuth 1.0a user context ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# true = print posts only, false = publish to X
DRY_RUN=true

API_PORT=8787
