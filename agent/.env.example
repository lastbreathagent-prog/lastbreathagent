# --- Robinhood Chain ---
RPC_URL=
# Leave empty before launch: the agent runs in PRE-LAUNCH mode (unborn, API only)
BREATH_TOKEN=
# Pons bonding curve + post-graduation pool, comma separated
POOL_ADDRESSES=
# LastbreathWill contract (holds the treasury, pays the will). See contracts/README.md
WILL_CONTRACT=
# Wallet the agent uses for buybacks (its buys never count as heartbeats)
AGENT_WALLET=
# Optional: old name for the treasury address
TREASURY_ADDRESS=
# Public URL of this agent API (used in the will snapshot link)
PUBLIC_URL=
TOKEN_DECIMALS=18
START_BLOCK=0

# --- Heartbeat rules ---
MIN_TRADE_TOKENS=10000
WALLET_COOLDOWN_SEC=60

# --- Status thresholds (beats per hour) ---
HEALTHY_MIN=60
ANXIOUS_MIN=20
COMA_AFTER_SEC=21600
DEATH_AFTER_SEC=86400
REBIRTH_AFTER_SEC=86400

# --- AI (optional; without it the agent uses built-in templates) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- X (Twitter) API, OAuth 1.0a user context ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# true = print posts only, false = publish to X
DRY_RUN=true

API_PORT=8787
